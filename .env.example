# ===== 应用 =====
LLM_DEFAULT_MODEL=qwen-plus
LLM_DEFAULT_TEMPERATURE=0.3
VL_MODEL=qwen-vl-max
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=sk-xxx

# ===== MinerU（云端解析）=====
# ===== MinerU（云端解析，只负责 PDF；Word/Excel 走本地 python-docx / openpyxl）=====
# 必须填 API 根地址：代码拼的是 {base}/file-urls/batch 与 {base}/extract-results/batch/{id}。
# 原仓库留的是 https://mineru.net/api/v4/extract/task（单个建任务接口），照抄会让整条链 404。
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_API_TOKEN=xxx
MINERU_MODEL_SOURCE=modelscope
MD_ROOT_DIR=

# ===== 本地模型（只有 EMBEDDING_PROVIDER=local / RERANK_PROVIDER=local 时才需要）=====
MODELSCOPE_OFFLINE=0
MODELSCOPE_CACHE=
HF_HOME=
BGE_M3_PATH=
BGE_M3=
BGE_DEVICE=cpu
BGE_FP16=0
BGE_RERANKER_LARGE=
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=0

# ===== Embedding / Rerank 供应商（dashscope | siliconflow | local）=====
# 只有 dashscope 能同时返回稠密+稀疏向量；siliconflow 的 bge-m3 只有稠密。
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/api/v1
EMBEDDING_API_KEY=
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=10
EMBEDDING_WANT_SPARSE=true

RERANK_PROVIDER=dashscope
RERANK_MODEL=gte-rerank-v2
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1
RERANK_API_KEY=
RERANK_TIMEOUT_SECONDS=30

# ===== Milvus / Zilliz Cloud =====
# 自建 Milvus 填 http://localhost:19530 并把 MILVUS_TOKEN 留空
MILVUS_URL=https://xxx.zillizcloud.com
MILVUS_TOKEN=
CHUNKS_COLLECTION=kb_chunks
MILVUS_METRIC_TYPE=COSINE
MILVUS_MIN_COSINE_SCORE=0.0

# ===== 对象存储（阿里云 OSS，替换原 MinIO）=====
OSS_ENABLED=true
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=xxx
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SIGNED_URL_TTL_SECONDS=3600
OSS_UPLOAD_PREFIX=rag

# ===== PostgreSQL（替换原 MongoDB）=====
PG_ENABLED=true
PG_DSN=postgresql://user:password@192.168.100.1:5432/agentic_rag

# ===== Redis（key 必须以 rag: 开头，ACL 用户 zhanggui 只有 ~rag:* 权限）=====
# 用途：任务状态/断点快照 + MQ 派发查询时的跨进程 SSE 事件总线（rag:sse:{session_id}:events）
REDIS_ENABLED=true
REDIS_URL=redis://zhanggui:password@192.168.100.1:6379/1
REDIS_TASK_TTL_SECONDS=86400

# ===== RabbitMQ（队列/交换机名必须以 zhanggui. 开头；URL 末段是 vhost）=====
# zhanggui.import.task 导入、zhanggui.query.task 查询；两者都关闭时退回进程内线程池
RABBITMQ_ENABLED=true
RABBITMQ_URL=amqp://zhanggui:password@192.168.100.1:5672/main
RABBITMQ_PREFETCH=1

# ===== 可观测（无 key 时自动关闭，不阻塞其他功能）=====
# LangSmith 开关与密钥的别名都认：LANGCHAIN_TRACING_V2 / LANGSMITH_TRACING /
# LANGSMITH_TRACING_V2，LANGCHAIN_API_KEY / LANGSMITH_API_KEY（SDK 不同版本读的名字不一样，
# 代码在建 LLM 客户端时会把别名写全）。密钥在 smith.langchain.com 申请，格式如 lsv2_pt_xxx。
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=agentic-rag
# TTFT / 延迟滑动窗口（进程内，GET /metrics 读取）
METRICS_ENABLED=true
METRICS_WINDOW_SIZE=200

# ===== 百炼 MCP（联网搜索）=====
# 必须是完整接入点：服务名 EnhancedSearch + /mcp 尾段（Streamable HTTP）。
# 旧的 .../mcps/ 和 .../mcps/WebSearch/sse 都 404；工具名 search_pro，入参只有 query。
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/EnhancedSearch/mcp

# ===== 日志 =====
LOG_CONSOLE_ENABLE=true
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_ENABLE=true
LOG_FILE_LEVEL=INFO
LOG_FILE_RETENTION=7 days

# ===== 调试开关 =====
ITEM_NAME_DIAG=false

# ===== 已废弃（保留说明，代码不再读取）=====
# MONGO_URL / MONGO_DB_NAME       -> 已由 PG_DSN 替换
# MINIO_ENDPOINT / MINIO_ACCESS_KEY / MINIO_SECRET_KEY / MINIO_BUCKET_NAME / MINIO_IMG_DIR / MINIO_SECURE
#                                 -> 已由 OSS_* 替换
# NEO4J_URI / NEO4J_DATABASE / NEO4J_USERNAME / NEO4J_PASSWORD
#                                 -> 代码无调用方，已删除

# ===== 新增：检索与上下文参数 =====
MILVUS_DENSE_WEIGHT=0.8
MILVUS_SPARSE_WEIGHT=0.2
MILVUS_SEARCH_TOP_K=5
CONTEXT_BUDGET_TOKENS=6000

# ===== 本地零凭据演示（scripts/demo_local.py 会自动覆盖以下值）=====
# EMBEDDING_PROVIDER=lexical
# RERANK_PROVIDER=none
# MILVUS_URL=output/demo/milvus_lite.db
# STORAGE_BACKEND=local
# HISTORY_BACKEND=sqlite
